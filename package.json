{
  "name": "testrigor-agentic-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic companion to the 'Zero to Hero with TestRigor' tutorial series: crawls Restful-Booker, proposes TestRigor test cases with Claude, and runs them via the official testRigor CLI.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
  "build": "tsc -p tsconfig.json",
  "crawl": "tsx src/crawl.ts",
  "generate": "tsx src/generate.ts",
  "push-and-run": "tsx src/push-and-run.ts",
  "smoke-test": "testrigor test-suite run --test-cases-path \"test-cases/**/*.txt\" --junit-report-save-path ./report.xml --verbose",
  "lint": "tsc --noEmit"
  },
  "dependencies": {
  "@anthropic-ai/sdk": "^0.32.0",
  "playwright": "^1.48.0"
  },
  "devDependencies": {
  "@testrigor/testrigor-cli": "^0.0.51-beta",
  "@types/node": "^24.0.0",
  "js-yaml": "^4.1.0",
  "@types/js-yaml": "^4.0.9",
  "openapi-typescript": "^7.4.0",
  "tsx": "^4.19.0",
  "typescript": "^5.6.0"
  }
}
